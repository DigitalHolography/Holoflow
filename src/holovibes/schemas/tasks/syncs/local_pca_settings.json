{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LocalPcaSettings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "width_x": {"type": "integer", "minimum": 1},
    "width_y": {"type": "integer", "minimum": 1},
    "stride_x": {"type": "integer", "minimum": 1},
    "stride_y": {"type": "integer", "minimum": 1},
    "rank_factor": {"type": "number", "minimum": 0}

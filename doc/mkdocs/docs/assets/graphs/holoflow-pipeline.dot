digraph GraphPlan {
  rankdir=TB;
  compound=true;
  newrank=true;
  graph [nodesep=0.28, ranksep=0.75, pad=0.2, splines=polyline];
  node [fontname="Helvetica", shape=box];
  edge [fontname="Helvetica", fontsize=9];

  node [shape=point, width=0, height=0, label="", style=invis];
  L0; R0; L1; R1; L2; R2; L3a; R3a; L3b; R3b; L4; R4; L5; R5;
  L0 -> L1 -> L2 -> L3a -> L3b -> L4 -> L5 [style=invis, weight=1000];
  R0 -> R1 -> R2 -> R3a -> R3b -> R4 -> R5 [style=invis, weight=1000];

  node [shape=box, style="rounded,filled", fillcolor="#ccffcc", color="#555555",
        fontsize=10, margin="0.12,0.08"];
  v0 [label="source_0\nHolofile"];
  v1 [label="memcpy_1\nMemcpy"];
  v3 [label="conversion_3\nConversion"];
  v4 [label="reshape_4\nReshape"];
  v6 [label="pca_6\nPca"];
  v7 [label="filter_2d_7\nFilter2D"];
  v9 [label="fresnel_diffraction_9\nFresnelDiffraction"];
  v10 [label="mean_10\nMean"];
  v11 [label="fftshift_11\nFFTShiftNp"];
  v12 [label="flatfield_12\nFlatfield"];
  v13 [label="mean_13\nMean"];
  v15 [label="pct_clip_15\nPctClip"];
  v16 [label="conversion_16\nConversion"];
  v18 [label="xy_processed_display_18\nDisplayTensorXY"];

  v2_in [label="batch_queue_2\nProducer / Write", shape=invhouse, fillcolor="#e6f2ff",
         color="#0066cc", style="filled,dashed"];
  v2_out [label="batch_queue_2\nConsumer / Read", shape=house, fillcolor="#ffe6e6",
          color="#cc0000", style="filled,dashed"];
  v5_in [label="batch_queue_5\nProducer / Write", shape=invhouse, fillcolor="#e6f2ff",
         color="#0066cc", style="filled,dashed"];
  v5_out [label="batch_queue_5\nConsumer / Read", shape=house, fillcolor="#ffe6e6",
          color="#cc0000", style="filled,dashed"];
  v8_in [label="dual_reader_batch_queue_8\nProducer / Write", shape=invhouse,

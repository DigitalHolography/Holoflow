  v8_out [label="dual_reader_batch_queue_8\nConsumer / Read", shape=house,
          fillcolor="#ffe6e6", color="#cc0000", style="filled,dashed"];
  v14_in [label="slide_avg_14\nProducer / Write", shape=invhouse, fillcolor="#e6f2ff",

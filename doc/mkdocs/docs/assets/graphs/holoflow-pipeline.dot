  t19 [label="t19 / s18\nU8 · Device\n1×320×512",
       tooltip="tid: 19\nslot: 18\nshape: [1,320,512]\ndtype: U8\nmem_loc: Device\nstrides: [163840,512,1]\noffset: 0"];

  subgraph cluster_section_0 {
    label="Section 0"; labelloc=t; labeljust=l; style=rounded; color=gray; bgcolor="#f8f8f8";
    { rank=same; L0; v0; t0; v1; t1; v2_in; R0; }
    L0 -> v0 -> t0 -> v1 -> t1 -> v2_in -> R0 [style=invis, weight=1000];
  }
  subgraph cluster_section_1 {
    label="Section 1"; labelloc=t; labeljust=l; style=rounded; color=gray; bgcolor="#f8f8f8";
    { rank=same; L1; v5_in; t4; v4; t3; v3; t2; v2_out; R1; }
    L1 -> v5_in -> t4 -> v4 -> t3 -> v3 -> t2 -> v2_out -> R1 [style=invis, weight=1000];
  }
  subgraph cluster_section_2 {
    label="Section 2"; labelloc=t; labeljust=l; style=rounded; color=gray; bgcolor="#f8f8f8";
    { rank=same; L2; v5_out; t5; v6; t6; v7; t7; v8_in; R2; }
    L2 -> v5_out -> t5 -> v6 -> t6 -> v7 -> t7 -> v8_in -> R2 [style=invis, weight=1000];
  }
  subgraph cluster_section_3 {
    label="Section 3"; labelloc=t; labeljust=l; style=rounded; color=gray; bgcolor="#f8f8f8";
    { rank=same; L3a; v11; t12; v10; t11; v9; t8; v8_out; R3a; }
    L3a -> v11 -> t12 -> v10 -> t11 -> v9 -> t8 -> v8_out -> R3a [style=invis, weight=1000];
    { rank=same; L3b; t13; v12; t14; v13; t15; v14_in; R3b; }
    L3b -> t13 -> v12 -> t14 -> v13 -> t15 -> v14_in -> R3b [style=invis, weight=1000];
  }
  subgraph cluster_section_4 {
    label="Section 4"; labelloc=t; labeljust=l; style=rounded; color=gray; bgcolor="#f8f8f8";
    { rank=same; L4; v17_in; t18; v16; t17; v15; t16; v14_out; R4; }
    L4 -> v17_in -> t18 -> v16 -> t17 -> v15 -> t16 -> v14_out -> R4 [style=invis, weight=1000];

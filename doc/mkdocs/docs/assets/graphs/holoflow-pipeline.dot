  t4 [label="t4 / s3\nF32 · Device\n1×32×320×512",
      tooltip="tid: 4\nslot: 3\nshape: [1,32,320,512]\ndtype: F32\nmem_loc: Device\nstrides: [20971520,655360,2048,4]\noffset: 0"];
  t5 [label="t5 / s4\nF32 · Device\n8×32×320×512",

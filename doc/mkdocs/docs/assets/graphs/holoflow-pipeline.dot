  v17_in [label="batch_queue_17\nProducer / Write", shape=invhouse, fillcolor="#e6f2ff",
          color="#0066cc", style="filled,dashed"];
  v17_out [label="batch_queue_17\nConsumer / Read", shape=house, fillcolor="#ffe6e6",
           color="#cc0000", style="filled,dashed"];

  node [shape=box, style="rounded,filled", fillcolor="#fffdf5", color="#aaaaaa",
        fontsize=8, margin="0.08,0.05"];
  t0 [label="t0 / s0\nU8 · Host\n32×320×512",
      tooltip="tid: 0\nslot: 0\nshape: [32,320,512]\ndtype: U8\nmem_loc: Host\nstrides: [163840,512,1]\noffset: 0"];
  t1 [label="t1 / s1\nU8 · Device\n32×320×512",

  v0:e -> t0:w [arrowhead=none]; t0:e -> v1:w; v1:e -> t1:w [arrowhead=none]; t1:e -> v2_in:w;
  v2_out:w -> t2:e [arrowhead=none]; t2:w -> v3:e; v3:w -> t3:e [arrowhead=none];
  t3:w -> v4:e; v4:w -> t4:e [arrowhead=none]; t4:w -> v5_in:e;
  v5_out:e -> t5:w [arrowhead=none]; t5:e -> v6:w; v6:e -> t6:w [arrowhead=none];
  t6:e -> v7:w; v7:e -> t7:w [arrowhead=none]; t7:e -> v8_in:w;
  v8_out:w -> t8:e [arrowhead=none]; t8:w -> v9:e; v9:w -> t11:e [arrowhead=none];
  t11:w -> v10:e; v10:w -> t12:e [arrowhead=none]; t12:w -> v11:e;
  v11:s -> t13:n [arrowhead=none]; t13:e -> v12:w; v12:e -> t14:w [arrowhead=none];
  t14:e -> v13:w; v13:e -> t15:w [arrowhead=none]; t15:e -> v14_in:w;
  v14_out:w -> t16:e [arrowhead=none]; t16:w -> v15:e; v15:w -> t17:e [arrowhead=none];
  t17:w -> v16:e; v16:w -> t18:e [arrowhead=none]; t18:w -> v17_in:e;
  v17_out:e -> t19:w [arrowhead=none]; t19:e -> v18:w;

  edge [style=dotted, color="#888888", fontcolor="#666666", penwidth=2,
        arrowsize=0.7, arrowhead=none, constraint=false];
  v2_in:s -> v2_out:n [xlabel="async"];
  v5_in:s -> v5_out:n [xlabel="async"];
  v8_in:s -> v8_out:n [xlabel="async"];
  v14_in:s -> v14_out:n [xlabel="async"];
  v17_in:s -> v17_out:n [xlabel="async"];
}

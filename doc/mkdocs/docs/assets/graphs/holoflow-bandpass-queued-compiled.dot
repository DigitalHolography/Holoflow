digraph GraphPlan {
  rankdir=TB;
  compound=true;
  newrank=true;
  graph [nodesep=0.28, ranksep=0.75, pad=0.2, splines=polyline, bgcolor="transparent"];
  node [fontname="Helvetica", shape=box];
  edge [fontname="Helvetica", fontsize=9];

  node [shape=point, width=0, height=0, label="", style=invis];
  L0; R0; L1a; R1a; L1b; R1b; L2; R2;
  L0 -> L1a -> L1b -> L2 [style=invis, weight=1000];
  R0 -> R1a -> R1b -> R2 [style=invis, weight=1000];

  node [shape=box, style="rounded,filled", fillcolor="#ccffcc", color="#555555",
        fontsize=10, margin="0.12,0.08"];
  v0 [label="load\nLoadNpy"];
  v1 [label="upload\nMemcpy"];
  v2 [label="fft\nRFFT2"];
  v3 [label="mask\nBandpassMask"];
  v4 [label="multiply\nMultiply"];
  v5 [label="ifft\nIRFFT2"];
  v6 [label="download\nMemcpy"];
  v7 [label="save\nSaveNpy"];

  q0_in [label="upload_queue\nProducer / Write", shape=invhouse, fillcolor="#e6f2ff",
         color="#0066cc", style="filled,dashed"];
  q0_out [label="upload_queue\nConsumer / Read", shape=house, fillcolor="#ffe6e6",
          color="#cc0000", style="filled,dashed"];
  q1_in [label="download_queue\nProducer / Write", shape=invhouse, fillcolor="#e6f2ff",
         color="#0066cc", style="filled,dashed"];
  q1_out [label="download_queue\nConsumer / Read", shape=house, fillcolor="#ffe6e6",
          color="#cc0000", style="filled,dashed"];

  node [shape=box, style="rounded,filled", fillcolor="#fffdf5", color="#aaaaaa",
        fontsize=8, margin="0.08,0.05"];
  t0 [label="t0 / s0\nF32 - Host\n1x512x512"];
  t1 [label="t1 / s1\nF32 - Device\n1x512x512"];
  t2 [label="t2 / s2\nF32 - Device\n1x512x512"];
  t3 [label="t3 / s3\nCF32 - Device\n1x512x257"];
  t4 [label="t4 / s4\nCF32 - Device\n1x512x257"];
  t5 [label="t5 / s5\nCF32 - Device\n1x512x257"];
  t6 [label="t6 / s6\nF32 - Device\n1x512x512"];
  t7 [label="t7 / s7\nF32 - Device\n1x512x512"];
  t8 [label="t8 / s8\nF32 - Host\n1x512x512"];

  subgraph cluster_section_0 {
    label="Section 0";
    labelloc=t;
    labeljust=l;
    style=rounded;
    color=gray;
    bgcolor="#f8f8f8";
    { rank=same; L0; v0; t0; v1; t1; q0_in; R0; }
    L0 -> v0 -> t0 -> v1 -> t1 -> q0_in -> R0 [style=invis, weight=1000];
  }

  subgraph cluster_section_1 {
    label="Section 1";
    labelloc=t;
    labeljust=l;
    style=rounded;
    color=gray;
    bgcolor="#f8f8f8";
    { rank=same; L1a; v3; t4; R1a; }
    L1a -> v3 -> t4 -> R1a [style=invis, weight=1000];
    { rank=same; L1b; q1_in; t6; v5; t5; v4; t3; v2; t2; q0_out; R1b; }
    L1b -> q1_in -> t6 -> v5 -> t5 -> v4 -> t3 -> v2 -> t2 -> q0_out -> R1b
      [style=invis, weight=1000];
  }

  subgraph cluster_section_2 {
    label="Section 2";
    labelloc=t;
    labeljust=l;
    style=rounded;
    color=gray;
    bgcolor="#f8f8f8";
    { rank=same; L2; q1_out; t7; v6; t8; v7; R2; }
    L2 -> q1_out -> t7 -> v6 -> t8 -> v7 -> R2 [style=invis, weight=1000];
  }

  edge [style=solid, color="#444444", fontcolor="#444444", penwidth=1.2,
        arrowsize=0.65, arrowhead=normal, constraint=false];
  v0:e -> t0:w;
  t0:e -> v1:w;
  v1:e -> t1:w;
  t1:e -> q0_in:w;
  q0_out:w -> t2:e;
  t2:w -> v2:e;
  v2:w -> t3:e;
  t3:w -> v4:e;
  v3:s -> t4:n;
  t4:s -> v4:n;
  v4:w -> t5:e;
  t5:w -> v5:e;
  v5:w -> t6:e;
  t6:w -> q1_in:e;
  q1_out:e -> t7:w;
  t7:e -> v6:w;
  v6:e -> t8:w;
  t8:e -> v7:w;

  edge [style=dotted, color="#888888", fontcolor="#666666", penwidth=2,
        arrowsize=0.7, arrowhead=none, constraint=false];
  q0_in:s -> q0_out:n [xlabel="async"];
  q1_in:s -> q1_out:n [xlabel="async"];
}
